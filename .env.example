# soroban-event-indexer configuration. Copy to .env and edit.
# Every variable is optional; the values below are the defaults.
# Full reference: docs/configuration.md

# SQLAlchemy URL. SQLite by default; for PostgreSQL use e.g.
# postgresql+psycopg://indexer:indexer@localhost:5432/indexer
DATABASE_URL=sqlite:///./soroban_events.db

# Stellar RPC endpoint (testnet by default). Mainnet needs your own node or a provider.
RPC_URL=https://soroban-testnet.stellar.org

# First ledger to index on the very first run. Empty = start at the latest ledger.
# Must be inside the RPC node's retention window. Ignored once a cursor is stored.
START_LEDGER=

# Comma-separated contract addresses (C...) to index, at most 25. Empty = all contracts.
CONTRACT_IDS=

# Seconds to wait between polls once caught up.
POLL_INTERVAL_SECONDS=5

# Events requested per getEvents call (1-10000).
PAGE_LIMIT=100

# HTTP timeout for each RPC request, in seconds.
RPC_TIMEOUT_SECONDS=30

# Exponential backoff after RPC errors: first delay and cap, in seconds.
BACKOFF_INITIAL_SECONDS=1
BACKOFF_MAX_SECONDS=60

# REST API bind address.
API_HOST=0.0.0.0
API_PORT=8000

# Comma-separated allowed CORS origins, or * for any.
CORS_ORIGINS=*

# DEBUG, INFO, WARNING, ERROR or CRITICAL.
LOG_LEVEL=INFO
